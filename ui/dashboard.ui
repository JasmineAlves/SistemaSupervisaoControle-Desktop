  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #F4F0F8;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #1A1030;
}

QMessageBox {
    background-color: #F4F0F8;
    color: #1A1030;
    font-family: "Segoe UI";
    font-size: 12px;
}

QMessageBox QLabel {
    background-color: transparent;
    color: #6B5B7A;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: 600;
    padding: 8px;
}

QMessageBox QLabel#qt_msgboxex_icon_label {
    background-color: transparent;
    padding: 8px;
}

QMessageBox QPushButton {
    background-color: #FFFFFF;
    color: #1A1030;
    border: 1px solid #D4C8E0;
    border-radius: 7px;
    padding: 8px 18px;
    min-width: 90px;
    min-height: 32px;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: 600;
}

QMessageBox QPushButton:hover {
    background-color: #F0ECF5;
    border-color: #8B5CF6;
}

QMessageBox QPushButton:pressed {
    background-color: #DDD0E8;
}

QMessageBox QPushButton:default {
    background-color: #3D1A6B;
    color: #FFFFFF;
    border: 1px solid #3D1A6B;
}

QMessageBox QPushButton:default:hover {
    background-color: #4D2A7B;
    border-color: #4D2A7B;
}

QMessageBox QPushButton:default:pressed {
    background-color: #31124F;
    border-color: #31124F;
}

QFrame#header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1A0A30, stop:1 #3D1A6B);
    border-radius: 14px;
}

QLabel#lbl_titulo {
    color: #FFFFFF;
    font-size: 25px;
    font-weight: 700;
}

QLabel#lbl_subtitulo {
    color: #B8A0D4;
    font-size: 12px;
}

QLabel#lbl_status_comunicacao {
    color: #B8A0D4;
    font-size: 12px;
    font-weight: 600;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(184, 160, 212, 0.35);
    border-radius: 12px;
    padding: 6px 14px;
}

QLabel#lbl_status_comunicacao[state=&quot;on&quot;] {
    color: #A78BFA;
    border-color: rgba(167, 139, 250, 0.5);
}

QLabel#lbl_status_comunicacao[state=&quot;off&quot;] {
    color: #E1B8B4;
    border-color: rgba(225, 184, 180, 0.4);
}

QFrame.metricCard {
    background-color: #FFFFFF;
    border: 1px solid #DCD0E8;
    border-radius: 12px;
}

QFrame#grupo_tensao { border-left: 4px solid #6D28D9; }
QFrame#grupo_corrente { border-left: 4px solid #7C3AED; }
QFrame#grupo_potencia { border-left: 4px solid #8B5CF6; }
QFrame#grupo_potencia[alerta=&quot;true&quot;] { border-left: 4px solid #EA580C; background: #FFF7ED; }

QLabel.metricTitle {
    color: #6B5B7A;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel.metricValue {
    color: #1A1030;
    font-size: 29px;
    font-weight: 700;
}

QLabel.metricUnit {
    color: #6B5B7A;
    font-size: 13px;
    font-weight: 600;
}

QLabel.metricFooter {
    color: #8B7A9A;
    font-size: 11px;
}

QFrame.panel {
    background-color: #FFFFFF;
    border: 1px solid #DCD0E8;
    border-radius: 12px;
}

QLabel.panelTitle {
    color: #1A1030;
    font-size: 15px;
    font-weight: 700;
}

QLabel.panelSubtitle {
    color: #8B7A9A;
    font-size: 11px;
}

QFrame#statusCard {
    border-radius: 12px;
}

QFrame#statusCard[estado=&quot;fechado&quot;] {
    background: #F0ECF5;
    border: 1px solid #D4C8E0;
}

QFrame#statusCard[estado=&quot;aberto&quot;] {
    background: #FDECEC;
    border: 1px solid #F3C1BC;
}

QLabel#lbl_status_disjuntor[estado=&quot;fechado&quot;] {
    color: #5B21B6;
    font-size: 18px;
    font-weight: 700;
}

QLabel#lbl_status_disjuntor[estado=&quot;aberto&quot;] {
    color: #B42318;
    font-size: 18px;
    font-weight: 700;
}

QLabel#lbl_status_detalhe {
    color: #6B5B7A;
    font-size: 11px;
}

QLabel#lbl_status_atualizacao {
    color: #8B7A9A;
    font-size: 10px;
}

QFrame#controlePanel {
    background-color: #F0ECF5;
    border: 1px solid #DCD0E8;
    border-radius: 12px;
}

QLabel.controlTitle {
    color: #6B5B7A;
    font-size: 11px;
    font-weight: 700;
}

QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D4C8E0;
    border-radius: 7px;
    padding: 6px 8px;
    min-height: 28px;
}

QDoubleSpinBox:focus {
    border: 1px solid #6D28D9;
}

QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
}

QPushButton {
    background-color: #FFFFFF;
    color: #1A1030;
    border: 1px solid #D4C8E0;
    border-radius: 7px;
    padding: 9px 14px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #F0ECF5;
    border-color: #8B5CF6;
}

QPushButton#btn_configuracao,
QPushButton#btn_comunicacao {
    background-color: #3D1A6B;
    color: #FFFFFF;
    border: none;
}

QPushButton#btn_configuracao:hover,
QPushButton#btn_comunicacao:hover {
    background-color: #4D2A7B;
}

QPushButton#btn_corte_emergencia {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #E23B32, stop:1 #B91C1C);
    color: #FFFFFF;
    border: none;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#btn_corte_emergencia:hover {
    background: #C0271F;
}

QPushButton#btn_corte_emergencia:pressed {
    background: #9E1B15;
}

QFrame#historicoPanel {
    background-color: #FFFFFF;
    border: 1px solid #DCD0E8;
    border-radius: 12px;
}

QTableWidget {
    background-color: #FFFFFF;
    border: none;
    gridline-color: #EDE8F0;
    selection-background-color: #DDD0E8;
    selection-color: #1A1030;
    alternate-background-color: #F8F4FA;
}

QHeaderView::section {
    background-color: #F0ECF5;
    color: #6B5B7A;
    border: none;
    border-bottom: 1px solid #DCD0E8;
    padding: 8px;
    font-size: 11px;
    font-weight: 700;
}

QStatusBar {
    background-color: #EDE8F0;
    color: #6B5B7A;
}

QScrollBar:vertical {
    width: 7px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #D4C8E0;
    border-radius: 3px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background: #8B5CF6;
}
