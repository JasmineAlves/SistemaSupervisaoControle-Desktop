  <property name="windowTitle"><string>Comunicação Serial</string></property>
  <property name="styleSheet">
   <string notr="true">
/* ===== Base (mesmos tokens do dashboard) ===== */
QDialog {
    background-color: #F4F0F8;
}

QWidget {
    font-family: "Segoe UI";
    color: #1A1030;
}

QMessageBox {
    background-color: #3D1A6B;
    color: #ffffff;
}

QMessageBox QLabel {
    color: #ffffff;
}

/* ===== Cabeçalho ===== */
QFrame#header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1A0A30, stop:1 #3D1A6B);
    border-radius: 14px;
}

QLabel#lbl_titulo {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
}

QLabel#lbl_subtitulo {
    color: #B8A0D4;
    font-size: 12px;
}

/* ===== Painel de status da conexão ===== */
QFrame#statusCard {
    border-radius: 12px;
}

QFrame#statusCard[estado="conectado"] {
    background: #F0ECF5;
    border: 1px solid #D4C8E0;
}

QFrame#statusCard[estado="desconectado"] {
    background: #FDECEC;
    border: 1px solid #F3C1BC;
}

QLabel#lbl_status[estado="conectado"] {
    color: #5B21B6;
    font-size: 15px;
    font-weight: 700;
}

QLabel#lbl_status[estado="desconectado"] {
    color: #B42318;
    font-size: 15px;
    font-weight: 700;
}

/* ===== Painel de parâmetros ===== */
QFrame.panel {
    background-color: #FFFFFF;
    border: 1px solid #DCD0E8;
    border-radius: 12px;
}

QLabel.panelTitle {
    color: #1A1030;
    font-size: 15px;
    font-weight: 700;
}

QLabel.panelSubtitle {
    color: #8B7A9A;
    font-size: 11px;
}

QLabel.fieldLabel {
    color: #6B5B7A;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ===== Campos ===== */
QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D4C8E0;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 30px;
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #6D28D9;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DCD0E8;
    selection-background-color: #F0ECF5;
    selection-color: #1A1030;
    outline: none;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 0px; height: 0px; border: none; background: transparent;
}

/* ===== Botões ===== */
QPushButton {
    background-color: #FFFFFF;
    color: #1A1030;
    border: 1px solid #D4C8E0;
    border-radius: 7px;
    padding: 10px 16px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #F0ECF5;
    border-color: #8B5CF6;
}

QPushButton:disabled {
    color: #B7ABC4;
    background-color: #F7F4FA;
    border-color: #E6DEEE;
}

QPushButton#btn_conectar {
    background-color: #3D1A6B;
    color: #FFFFFF;
    border: none;
}

QPushButton#btn_conectar:hover {
    background-color: #4D2A7B;
}

QPushButton#btn_conectar:disabled {
    background-color: #C9BEDC;
    color: #F4F0F8;
}

QPushButton#btn_desconectar {
    color: #B42318;
    border: 1px solid #F3C1BC;
}

QPushButton#btn_desconectar:hover {
    background-color: #FDECEC;
    border-color: #E23B32;
}

QPushButton#btn_fechar {
    background: transparent;
    border: none;
    color: #6B5B7A;
}

QPushButton#btn_fechar:hover {
    color: #3D1A6B;
    text-decoration: underline;
}
   </string>
  </property>

