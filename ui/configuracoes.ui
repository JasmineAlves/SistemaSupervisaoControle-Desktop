  <property name="styleSheet">
   <string notr="true">
/* ===== Base (mesmos tokens do dashboard) ===== */
QDialog {
    background-color: #F4F0F8;
}

QWidget {
    font-family: "Segoe UI";
    color: #1A1030;
}

QMessageBox {
    background-color: #3D1A6B;
    color: #ffffff;
}

QMessageBox QLabel {
    color: #ffffff;
}

/* ===== Cabeçalho ===== */
QFrame#header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1A0A30, stop:1 #3D1A6B);
    border-radius: 14px;
}

QLabel#lbl_titulo {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
}

QLabel#lbl_subtitulo {
    color: #B8A0D4;
    font-size: 12px;
}

/* ===== Painel de regras ===== */
QFrame.panel {
    background-color: #FFFFFF;
    border: 1px solid #DCD0E8;
    border-radius: 12px;
}

QLabel.panelTitle {
    color: #1A1030;
    font-size: 15px;
    font-weight: 700;
}

QLabel.panelSubtitle {
    color: #8B7A9A;
    font-size: 11px;
}

QLabel.fieldLabel {
    color: #6B5B7A;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ===== Painel de previsão calculada ===== */
QFrame#previsaoCard {
    background-color: #F0ECF5;
    border: 1px solid #D4C8E0;
    border-radius: 12px;
}

QLabel#lbl_previsao_titulo {
    color: #6B5B7A;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#lbl_potencia_calculada {
    color: #5B21B6;
    font-size: 22px;
    font-weight: 700;
}

/* ===== Campos ===== */
QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D4C8E0;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 30px;
}

QDoubleSpinBox:focus {
    border: 1px solid #6D28D9;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 0px; height: 0px; border: none; background: transparent;
}

/* ===== Botões ===== */
QPushButton {
    background-color: #FFFFFF;
    color: #1A1030;
    border: 1px solid #D4C8E0;
    border-radius: 7px;
    padding: 10px 16px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #F0ECF5;
    border-color: #8B5CF6;
}

QPushButton#btn_salvar {
    background-color: #3D1A6B;
    color: #FFFFFF;
    border: none;
}

QPushButton#btn_salvar:hover {
    background-color: #4D2A7B;
}

QPushButton#btn_cancelar {
    color: #6B5B7A;
}
   </string>
